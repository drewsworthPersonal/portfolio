---
import { projects } from "../data/site";
---

<section class="section wrap" id="projects">
  <div class="section-head" data-reveal>
    <span class="num">03</span>
    <h2>Projects</h2>
  </div>

  <p class="swipe-hint mono" aria-hidden="true">Swipe for all {projects.length} projects →</p>
  <div class="grid" role="list">
    {
      projects.map((p) => (
        <article class:list={["project", { feature: p.feature }]} role="listitem" data-reveal>
          <div class="top">
            <p class="kicker mono">{p.kicker}</p>
            {p.link && (
              <a class="ext mono" href={p.link} target="_blank" rel="noopener">
                {p.linkLabel} ↗
              </a>
            )}
          </div>
          <h3>{p.name}</h3>
          <p class="blurb">{p.blurb}</p>
          <ul class="tags">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .grid { display: grid; gap: 16px; }
  .swipe-hint { display: none; }

  /*
    Phones: one row of cards you swipe sideways, each snapping into place (CSS scroll
    snap, no script). The row runs edge to edge so the next card peeks in from the right.
  */
  @media (max-width: 759px) {
    .swipe-hint { display: block; margin: -20px 0 14px; font-size: 12px; color: var(--muted); }
    .grid {
      display: flex;
      gap: 12px;
      margin: 0 calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 var(--gutter);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .grid::-webkit-scrollbar { display: none; }
    .project {
      flex: 0 0 84%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    /* No lift on tap; it reads as a stuck hover on touch screens */
    .project:hover { transform: none; }
    .feature .blurb { font-size: 15px; }
    .feature h3 { font-size: 1.25rem; }
  }
  @media (min-width: 760px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .feature { grid-column: 1 / -1; }
  }
  .project {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }
  .project:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); transform: translateY(-2px); }
  .feature { background: linear-gradient(140deg, var(--surface), var(--surface-2)); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; }
  .kicker { font-size: 12px; color: var(--muted); }
  .ext { font-size: 13px; color: var(--accent); text-decoration: none; }
  .ext:hover { text-decoration: underline; }
  h3 { margin-top: 10px; font-size: 1.25rem; }
  .feature h3 { font-size: 1.6rem; }
  .blurb { margin-top: 8px; color: var(--muted); font-size: 15px; }
  .feature .blurb { max-width: 70ch; font-size: 16px; }
  .tags { margin-top: auto; padding-top: 18px; }
</style>
