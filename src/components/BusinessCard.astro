---
import Logo from "./Logo.astro";
import { profile } from "../data/site";
---

<div class="stage" data-card-stage>
  <div class="card" data-card>
    <div class="face front">
      <div class="pattern" aria-hidden="true"></div>
      <div class="top">
        <Logo size={34} class="mark" label="drewsworth.dev logo" />
        <span class="chip" aria-hidden="true"></span>
      </div>
      <div class="bottom">
        <p class="name">{profile.name}</p>
        <p class="role">{profile.title} · {profile.location}</p>
        <p class="domain">{profile.domain}</p>
      </div>
      <div class="glare" aria-hidden="true"></div>
    </div>
    <div class="face back">
      <div class="pattern" aria-hidden="true"></div>
      <ul class="contact">
        <li><span>email</span><a href={`mailto:${profile.email}`} data-copy={profile.email} title="Copy email" aria-label={`Copy email address ${profile.email}`}>{profile.email}</a></li>
        <li><span>github</span><a href={profile.github} target="_blank" rel="noopener">{profile.githubLabel}</a></li>
        <li><span>linkedin</span><a href={profile.linkedin} target="_blank" rel="noopener">{profile.linkedinLabel}</a></li>
        <li><span>resume</span><a href={profile.resume} target="_blank" rel="noopener">Download PDF</a></li>
      </ul>
      <div class="glare" aria-hidden="true"></div>
    </div>
  </div>
  <div class="actions">
    <button class="flip" type="button" data-card-flip aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16M3 21v-5h5" /></svg>
      <span>Flip card</span>
    </button>
    <button class="flip" type="button" data-card-clear hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
      <span>Clear drawing</span>
    </button>
  </div>
  <p class="hint" data-card-hint>Click to flip · hold to draw</p>
</div>

<style>
  .stage {
    --rx: 0deg;
    --ry: 0deg;
    --flip: 0deg;
    --gx: 50%;
    --gy: 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    perspective: 1100px;
    touch-action: pan-y;
  }
  .card {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1.75;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + var(--flip)));
    cursor: pointer;
    will-change: transform;
    /* Holding to draw must not select text or open long-press menus */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .card.drawing { cursor: crosshair; }
  /* Drawing layer, added by card-drawing.ts */
  .face :global(.ink) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    padding: 22px 24px;
    border-radius: 18px;
    color: var(--card-ink);
    background:
      radial-gradient(120% 140% at 0% 0%, var(--card-b) 0%, transparent 60%),
      linear-gradient(140deg, var(--card-a), var(--card-b));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 24px 60px -20px rgba(0, 0, 0, 0.55),
      0 0 80px -10px var(--glow);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .back { transform: rotateY(180deg); display: flex; align-items: center; }

  .pattern {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(currentColor 1px, transparent 1px);
    background-size: 14px 14px;
    mask-image: linear-gradient(120deg, transparent 20%, #000 90%);
    -webkit-mask-image: linear-gradient(120deg, transparent 20%, #000 90%);
  }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx) var(--gy), var(--card-sheen), transparent 55%);
    mix-blend-mode: soft-light;
  }

  .front { display: flex; flex-direction: column; justify-content: space-between; }
  .top { position: relative; display: flex; justify-content: space-between; align-items: flex-start; }
  /* Same color as the logo in the header */
  .top :global(.mark) { display: block; color: var(--accent); }
  .chip {
    width: 40px;
    height: 30px;
    border-radius: 6px;
    background:
      linear-gradient(90deg, transparent 32%, rgba(0, 0, 0, 0.25) 32% 36%, transparent 36% 64%, rgba(0, 0, 0, 0.25) 64% 68%, transparent 68%),
      linear-gradient(0deg, transparent 45%, rgba(0, 0, 0, 0.25) 45% 55%, transparent 55%),
      linear-gradient(135deg, #f3d48a, #b8913c);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
  }
  .bottom { position: relative; }
  .name { font-family: var(--display); font-size: clamp(1.35rem, 4.6vw, 1.75rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  :global([data-theme="paper"]) .name { font-weight: 400; font-size: clamp(1.6rem, 5.4vw, 2.1rem); }
  .role { margin-top: 4px; font-size: 13px; opacity: 0.8; }
  .domain { margin-top: 10px; font-family: var(--mono); font-size: 12px; opacity: 0.65; }

  .contact { position: relative; display: grid; gap: 10px; width: 100%; }
  .contact li { display: grid; grid-template-columns: 72px 1fr; align-items: baseline; gap: 8px; }
  .contact span { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.6; }
  .contact a {
    justify-self: start;
    font-size: 14px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  /* Each theme sets its own hover color (Graphite grey, Terminal darker green, others the accent) */
  .contact a:hover { color: var(--card-link-hover); }

  .flip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
  }
  .flip:hover { color: var(--text); border-color: var(--accent); }
  .flip[hidden] { display: none; }
  .flip svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .hint { margin-top: -6px; font-size: 12px; color: var(--muted); }
</style>

<script>
  import { setupCardDrawing } from "../scripts/card-drawing";

  // Tilt toward the pointer and flip on click. The animation loop only runs while
  // the card is still moving toward its target, so it costs nothing at rest.
  const stage = document.querySelector<HTMLElement>("[data-card-stage]")!;
  const card = stage.querySelector<HTMLElement>("[data-card]")!;
  const flipBtn = stage.querySelector<HTMLButtonElement>("[data-card-flip]")!;
  const clearBtn = stage.querySelector<HTMLButtonElement>("[data-card-clear]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const REST = { rx: 4, ry: -10 };
  const cur = { rx: REST.rx, ry: REST.ry, flip: 0, gx: 50, gy: 30 };
  const tgt = { ...cur };
  let raf = 0;
  let last = 0;
  // True while a press or drawing is in progress; mouse and phone tilt pause
  let holding = false;

  function render() {
    stage.style.setProperty("--rx", `${cur.rx.toFixed(2)}deg`);
    stage.style.setProperty("--ry", `${cur.ry.toFixed(2)}deg`);
    stage.style.setProperty("--flip", `${cur.flip.toFixed(2)}deg`);
    stage.style.setProperty("--gx", `${cur.gx.toFixed(1)}%`);
    stage.style.setProperty("--gy", `${cur.gy.toFixed(1)}%`);
  }

  function tick(now: number) {
    const dt = Math.min((now - (last || now)) / 1000, 0.05);
    last = now;
    const k = 1 - Math.exp(-dt * 9);
    let moving = false;
    for (const key of ["rx", "ry", "flip", "gx", "gy"] as const) {
      const d = tgt[key] - cur[key];
      if (Math.abs(d) > 0.02) {
        cur[key] += d * k;
        moving = true;
      } else {
        cur[key] = tgt[key];
      }
    }
    render();
    raf = moving ? requestAnimationFrame(tick) : 0;
    if (!moving) last = 0;
  }

  function kick() {
    if (!raf) raf = requestAnimationFrame(tick);
  }

  function flip() {
    const flipped = tgt.flip === 0;
    tgt.flip = flipped ? 180 : 0;
    flipBtn.setAttribute("aria-pressed", String(flipped));
    if (reduced) {
      cur.flip = tgt.flip;
      render();
    } else kick();
  }

  if (!reduced) {
    card.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch" || holding) return;
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      tgt.ry = (x - 0.5) * 26;
      tgt.rx = (0.5 - y) * 18;
      tgt.gx = x * 100;
      tgt.gy = y * 100;
      kick();
    });
    card.addEventListener("pointerleave", () => {
      if (holding) return;
      tgt.rx = REST.rx;
      tgt.ry = REST.ry;
      tgt.gx = 50;
      tgt.gy = 30;
      kick();
    });
  }

  // Phone tilt: the card follows the device's orientation while it is on screen.
  // iOS needs a permission prompt from a tap, so it is requested on the first tap
  // of the card or Flip button. Android starts right away.
  type OrientationEventCtor = typeof DeviceOrientationEvent & {
    requestPermission?: () => Promise<"granted" | "denied">;
  };
  const Orientation = (window as { DeviceOrientationEvent?: OrientationEventCtor }).DeviceOrientationEvent;
  const canTilt = !reduced && !!Orientation && matchMedia("(pointer: coarse)").matches;
  const needsPermission = typeof Orientation?.requestPermission === "function";
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  let tiltOn = false;
  let asked = false;
  let listening = false;
  let onScreen = false;
  let base: { x: number; y: number } | null = null;

  // Holding the phone still for STILL_MS re-centers the card on the current position.
  // Readings within STILL_RANGE degrees of where the stillness began count as still,
  // so normal hand shake does not reset the timer.
  const STILL_MS = 1000;
  const STILL_RANGE = 1.5;
  let still: { x: number; y: number; since: number; done: boolean } | null = null;

  function trackStillness(x: number, y: number, now: number) {
    if (!still || Math.abs(x - still.x) > STILL_RANGE || Math.abs(y - still.y) > STILL_RANGE) {
      still = { x, y, since: now, done: false };
      return;
    }
    if (!still.done && now - still.since >= STILL_MS) {
      base = { x, y };
      still.done = true;
    }
  }

  function onOrient(e: DeviceOrientationEvent) {
    if (e.beta === null || e.gamma === null || holding) return;
    // Map device axes to screen axes so landscape works too
    const angle = screen.orientation?.angle ?? 0;
    let x = e.gamma;
    let y = e.beta;
    if (angle === 90) { x = e.beta; y = -e.gamma; }
    else if (angle === 270) { x = -e.beta; y = e.gamma; }
    else if (angle === 180) { x = -e.gamma; y = -e.beta; }

    // However the phone is held when tilt starts counts as level
    if (!base) base = { x, y };
    trackStillness(x, y, e.timeStamp);

    const dx = clamp(x - base.x, -25, 25);
    const dy = clamp(y - base.y, -25, 25);
    const ry = REST.ry + dx * 0.9;
    const rx = REST.rx - dy * 0.7;
    // Ignore sensor jitter so the animation loop can rest when the phone is still
    if (Math.abs(ry - tgt.ry) < 0.25 && Math.abs(rx - tgt.rx) < 0.25) return;
    tgt.ry = ry;
    tgt.rx = rx;
    tgt.gx = clamp(50 + dx * 2, 0, 100);
    tgt.gy = clamp(30 + dy * 2, 0, 100);
    kick();
  }

  function syncListener() {
    const want = tiltOn && onScreen;
    if (want === listening) return;
    listening = want;
    if (want) {
      base = null;
      still = null;
      window.addEventListener("deviceorientation", onOrient);
    } else {
      window.removeEventListener("deviceorientation", onOrient);
      tgt.rx = REST.rx;
      tgt.ry = REST.ry;
      tgt.gx = 50;
      tgt.gy = 30;
      kick();
    }
  }

  // fromTap: iOS only shows the prompt for a tap, and a denial there is final for
  // this page load. A silent attempt on load (Android grants it without a prompt)
  // can fail without using up the tap.
  async function enableTilt(fromTap: boolean) {
    if (!canTilt || tiltOn || asked) return;
    if (fromTap) asked = true;
    if (needsPermission) {
      try {
        if ((await Orientation!.requestPermission!()) !== "granted") return;
      } catch {
        return;
      }
    }
    tiltOn = true;
    syncListener();
  }

  if (canTilt) {
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      syncListener();
    }).observe(stage);
    screen.orientation?.addEventListener("change", () => {
      base = null;
      still = null;
    });
    enableTilt(false);
  }

  // Press and hold to draw. The card snaps flat while drawing so the ink lands
  // exactly under the pointer, and tilt resumes on release.
  const drawingCtl = setupCardDrawing(card, clearBtn, {
    activeFace: () => card.querySelector<HTMLElement>(tgt.flip === 180 ? ".back" : ".front")!,
    onPress: () => {
      holding = true;
    },
    onDrawStart: () => {
      cancelAnimationFrame(raf);
      raf = 0;
      cur.rx = tgt.rx = 0;
      cur.ry = tgt.ry = 0;
      cur.flip = tgt.flip;
      cur.gx = tgt.gx = 50;
      cur.gy = tgt.gy = 30;
      render();
    },
    onRelease: () => {
      holding = false;
      base = null; // phone tilt treats the current grip as level again
      still = null;
    },
  });

  if (matchMedia("(pointer: coarse)").matches) {
    stage.querySelector("[data-card-hint]")!.textContent = "Tap to flip · hold to draw";
  }

  card.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) return;
    if (drawingCtl.takeSuppressedClick()) return; // a drawing just ended: don't flip
    enableTilt(true);
    flip();
  });
  flipBtn.addEventListener("click", () => {
    enableTilt(true);
    flip();
  });

  render();
</script>
