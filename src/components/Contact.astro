---
import { profile } from "../data/site";
---

<section class="section wrap contact" id="contact">
  <div class="section-head" data-reveal>
    <span class="num">04</span>
    <h2>Contact</h2>
  </div>
  <p class="lede" data-reveal>Open to software engineering roles, internships, and good conversations. Email is the fastest way to reach me.</p>
  <a class="email" href={`mailto:${profile.email}`} data-reveal>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
    <span>{profile.email.split("@")[0]}@<wbr />{profile.email.split("@")[1]}</span>
  </a>
  <ul class="links" data-reveal>
    <li>
      <a href={profile.github} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" /></svg>
        GitHub
      </a>
    </li>
    <li>
      <a href={profile.linkedin} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0h.01z" /></svg>
        LinkedIn
      </a>
    </li>
    <li>
      <a href={profile.resume} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
        Resume
      </a>
    </li>
  </ul>
</section>

<footer class="footer">
  <div class="wrap">
    <p class="mono muted">© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
  </div>
</footer>

<style>
  .section.contact { padding-bottom: 96px; }
  .lede { max-width: 54ch; color: var(--muted); font-size: 1.1rem; }

  svg { flex: none; }
  svg.fill { fill: currentColor; }
  svg.stroke { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* Large outlined pill, same hover treatment as the buttons below it */
  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    max-width: 100%;
    margin-top: 22px;
    padding: 0.4em 0.85em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--display);
    font-size: clamp(0.95rem, 4.4vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .email span { min-width: 0; }
  .email svg { width: 0.85em; height: 0.85em; }
  .email:hover { border-color: var(--accent); background: var(--surface); }
  :global([data-theme="paper"]) .email { font-weight: 400; }

  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .links svg { width: 16px; height: 16px; }
  .links a:hover { color: var(--text); border-color: var(--accent); }

  .footer { padding: 24px 0; border-top: 1px solid var(--line); }
  .footer p { font-size: 13px; }
</style>
