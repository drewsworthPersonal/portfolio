<div class="sound" data-on="false">
  <button class="toggle" type="button" aria-pressed="false" aria-label="Play ambient music">
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </button>
  <label class="vol">
    <span class="visually-hidden">Volume</span>
    <input type="range" min="0" max="100" value="60" aria-label="Volume" />
  </label>
</div>

<style>
  .sound {
    display: flex;
    align-items: center;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .sound:hover, .sound:focus-within { border-color: var(--accent); }
  .toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 34px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }
  .bars { display: flex; align-items: center; gap: 2px; height: 14px; }
  .bars i {
    display: block;
    width: 2px;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
    transform: scaleY(0.25);
    transform-origin: center;
    transition: transform 0.3s var(--ease);
  }
  .sound[data-on="true"] .bars i { background: var(--accent); animation: eq 1.1s ease-in-out infinite; }
  .sound[data-on="true"] .bars i:nth-child(2) { animation-delay: -0.4s; }
  .sound[data-on="true"] .bars i:nth-child(3) { animation-delay: -0.75s; }
  .sound[data-on="true"] .bars i:nth-child(4) { animation-delay: -0.2s; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }

  /* Volume slider slides open while music is on */
  .vol {
    display: flex;
    align-items: center;
    width: 0;
    overflow: hidden;
    transition: width 0.3s var(--ease), padding 0.3s var(--ease);
  }
  .sound[data-on="true"] .vol { width: 84px; padding-right: 12px; }
  input[type="range"] {
    width: 72px;
    height: 4px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 520px) { .sound[data-on="true"] .vol { width: 0; padding: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .sound[data-on="true"] .bars i { animation: none; transform: scaleY(0.8); }
  }
</style>

<script>
  import { ambient } from "../scripts/ambient";

  const wrap = document.querySelector<HTMLElement>(".sound")!;
  const btn = wrap.querySelector<HTMLButtonElement>(".toggle")!;
  const range = wrap.querySelector<HTMLInputElement>('input[type="range"]')!;

  try {
    const saved = localStorage.getItem("volume");
    if (saved !== null) range.value = saved;
  } catch {}
  ambient.setVolume(Number(range.value) / 100);

  btn.addEventListener("click", async () => {
    const on = !ambient.playing;
    if (on) await ambient.start();
    else ambient.stop();
    wrap.dataset.on = String(on);
    btn.setAttribute("aria-pressed", String(on));
    btn.setAttribute("aria-label", on ? "Pause ambient music" : "Play ambient music");
  });

  range.addEventListener("input", () => {
    ambient.setVolume(Number(range.value) / 100);
    try { localStorage.setItem("volume", range.value); } catch {}
  });
</script>
