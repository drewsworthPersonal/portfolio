---
import ThemePicker from "./ThemePicker.astro";
import SoundControl from "./SoundControl.astro";
import Brand from "./Brand.astro";
import TabBar from "./TabBar.astro";
---

<header class="nav">
  <div class="wrap nav-inner">
    <Brand collapse />
    <nav aria-label="Sections">
      <ul class="links">
        <li><a href="/#about">About</a></li>
        <li><a href="/#experience">Experience</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>
    <!-- On wide screens these move into the profile sidebar while it is showing -->
    <div class="controls" data-nav-controls>
      <SoundControl />
      <ThemePicker />
    </div>
  </div>
</header>
<TabBar />

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--line);
    transition: transform 0.35s var(--ease), visibility 0s;
    view-transition-name: site-nav;
  }
  /* Wide screens: the nav slides away while the profile sidebar is showing */
  @media (min-width: 1200px) {
    :global(html.rail-on) .nav {
      transform: translateY(-100%);
      visibility: hidden;
      transition: transform 0.35s var(--ease), visibility 0s linear 0.35s;
    }
  }
  .nav-inner { display: flex; align-items: center; gap: 12px; height: 64px; }
  nav { margin-left: auto; }
  .links { display: flex; gap: 2px; }
  .links a {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .links a:hover { color: var(--text); background: var(--surface-2); }
  .controls { display: flex; align-items: center; gap: 8px; }
  /* Phones: the section links move to the bottom tab bar, so only Blog stays up here */
  @media (max-width: 680px) {
    .links li:not(:last-child) { display: none; }
    .links a { padding: 6px 8px; font-size: 13px; }
  }

  /*
    The bar shrinks from 64px to 52px over the first 120px of scrolling. Driven by the
    page's own scroll position in CSS, with no script. Browsers without scroll-driven
    animations keep the full-height bar.
  */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .nav-inner {
        animation-name: nav-shrink;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 120px;
      }
      .nav {
        animation-name: nav-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 120px;
      }
    }
  }
  @keyframes nav-shrink { to { height: 52px; } }
  @keyframes nav-settle { to { box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18); } }

  @media (prefers-reduced-motion: reduce) {
    .nav, :global(html.rail-on) .nav { transition: none; }
  }
</style>
