---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/instrument-serif";
import "../styles/themes.css";
import "../styles/global.css";
import { themes, defaultDark, defaultLight } from "../data/themes";
import Backdrop from "../components/Backdrop.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Apps require an absolute URL for the preview image
const ogImage = new URL("/og-image.png", Astro.site).href;
const themeIds = themes.map((t) => t.id);
---

<!doctype html>
<html lang="en" data-theme={defaultDark}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Andrew Velazquez" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Link previews (iMessage, WhatsApp, Instagram, Telegram, Slack, LinkedIn, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="drewsworth.dev" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="drewsworth.dev logo with Andrew Velazquez, software engineer in San Antonio, TX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply the saved theme (or the device's light/dark default) before first paint so there is no flash -->
    <script is:inline define:vars={{ themeIds, defaultDark, defaultLight }}>
      var root = document.documentElement;
      root.classList.add("js");
      var light = window.matchMedia && matchMedia("(prefers-color-scheme: light)").matches;
      root.dataset.theme = light ? defaultLight : defaultDark;
      try {
        var saved = localStorage.getItem("theme");
        if (saved && themeIds.indexOf(saved) !== -1) root.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Backdrop />
    <slot />
    <script>
      import "../scripts/reveal";
      import "../scripts/copy";
    </script>
  </body>
</html>
